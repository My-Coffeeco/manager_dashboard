{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "*.{html,css,js,woff2,avif,sql,json},client/dist/**",
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/admin/auth/(.*)", "destination": "/api" },
    { "source": "/admin/dashboard", "destination": "/api" },
    { "source": "/admin/orders/(.*)", "destination": "/api" },
    { "source": "/admin/alerts/(.*)", "destination": "/api" },
    { "source": "/admin/stores", "destination": "/api" },
    { "source": "/webhooks/(.*)", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/manager", "destination": "/index.html" }
  ]
}
