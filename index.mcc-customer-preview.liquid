    <button class="account-menu-toggle" id="account-menu-toggle" type="button" aria-expanded="false" aria-controls="account-navigation"><span><span data-icon="grid"></span><span id="mobile-section-label">Dashboard</span></span><span data-icon="chevron" class="menu-chevron"></span></button>
    <nav id="account-navigation" aria-label="Account sections"></nav>
  </aside>
  <main id="account-main" tabindex="-1">
    <div class="page-heading"><p class="overline">YOUR COFFEE CORNER</p><h1 id="section-title">MY ACCOUNT DASHBOARD</h1><p id="section-description">A little overview of your account. Everything in one place.</p></div>
    <section id="section-dashboard" class="account-section" aria-labelledby="section-title">
      <div class="stat-grid">
        <article class="stat-card"><div><h2>Total Orders</h2><strong>0</strong><span class="stat-note">No orders yet</span></div><span class="stat-icon stat-blue" data-icon="box"></span></article>
        <article class="stat-card"><div><h2>Total Spent</h2><strong id="total-spent">₹0</strong><span class="stat-note">Sample account total</span></div><span class="stat-icon stat-yellow" data-icon="wallet"></span></article>
        <article class="stat-card"><div><h2>Wishlist Items</h2><strong>0</strong><span class="stat-note">Your next favourites</span></div><span class="stat-icon stat-blue" data-icon="heart"></span></article>
      </div>
