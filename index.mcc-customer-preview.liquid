      <article class="account-panel"><div class="panel-heading"><h2>Personal details</h2><button type="button" class="edit-link" data-edit-profile><span data-icon="edit"></span>Edit <span class="sr-only">profile</span></button></div><dl class="profile-list"><div><dt>Full name</dt><dd data-customer-name>Aarav Mehta</dd></div><div><dt>Email address</dt><dd data-customer-email>aarav.mehta@example.com</dd></div><div><dt>Phone number</dt><dd data-customer-phone>Not added yet</dd></div></dl></article>
      <article class="account-panel secondary-panel"><h2>Saved addresses</h2><p>No addresses are connected. Saved and default addresses will stay with your Shopify customer account.</p></article>
