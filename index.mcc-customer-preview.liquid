  <div class="header-tools"><a class="icon-control account-control" href="#dashboard" aria-label="Your account"><span data-icon="user"></span></a><button class="icon-control" type="button" id="open-search" aria-label="Search preview" aria-haspopup="dialog"><span data-icon="search"></span></button><button class="icon-control cart-control" type="button" id="open-cart" aria-label="Preview cart, 0 items" aria-haspopup="dialog"><span data-icon="bag"></span><span class="cart-count" aria-hidden="true">0</span></button></div>
</div></header>
